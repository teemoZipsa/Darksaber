# Local development example. Copy to .env and change secrets before use outside local testing.

# Client -> server URLs
VITE_AUTH_SERVER_URL=http://localhost:8765
VITE_WORLD_SERVER_URL=ws://localhost:8765

# Postgres used by docker-compose.yml
DATABASE_URL=postgres://darksaber:darksaber_dev_password@127.0.0.1:5432/darksaber

# Use a long random value in real deployments. Required when NODE_ENV=production.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ISSUER=darksaber-world
AUTH_JWT_AUDIENCE=darksaber-client
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Local HTTP only. In production omit this or set 1 so refresh cookies stay Secure.
AUTH_REFRESH_COOKIE_SECURE=0
AUTH_REFRESH_COOKIE_SAMESITE=Lax

# Comma-separated browser origins allowed to call auth HTTP APIs and open world WebSockets.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

WORLD_SHARD_COUNT=1
