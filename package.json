{
  "name": "sin-eater",
  "version": "0.1.0",
  "description": "Sin Eater — Grid-based SRPG with growth weapon system",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "npx tsx server/index.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/raid/*.test.ts tests/field/*.test.ts",
    "test:raid": "node --import tsx --test tests/raid/*.test.ts",
    "test:field": "node --import tsx --test tests/field/*.test.ts"
  },
  "keywords": [
    "srpg",
    "grid",
    "rpg",
    "sin-eater"
  ],
  "author": "teemoZipsa",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  }
}
