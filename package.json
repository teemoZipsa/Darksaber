{
  "name": "darksaber",
  "version": "0.1.0",
  "description": "Darksaber : Extraction — grid-based SRPG extraction RPG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:town": "node scripts/dev-town.mjs",
    "dev:raid": "node scripts/dev-town.mjs raid",
    "dev:raid:aggro": "node scripts/dev-town.mjs raid aggro",
    "dev:raid:loot": "node scripts/dev-town.mjs raid loot",
    "dev:raid:story": "node scripts/dev-town.mjs raid",
    "dev:tutorial": "node scripts/dev-town.mjs tutorial",
    "start": "npm run dev",
    "build": "tsc && vite build",
    "build:server": "npm run typecheck:server && node scripts/build-server.mjs",
    "preview": "vite preview",
    "db:check": "npx tsx server/check-db.ts",
    "db:migrate": "npx tsx server/migrate-db.ts",
    "db:migrate:prod": "node server-dist/server/migrate-db.js",
    "server": "npx tsx server/index.ts",
    "server:prod": "node server-dist/server/index.js",
    "render:status": "node scripts/render-deploy.mjs status",
    "render:deploy": "node scripts/render-deploy.mjs deploy",
    "render:wait": "node scripts/render-deploy.mjs wait",
    "deploy:prod": "node scripts/deploy-production.mjs",
    "verify:story": "npm run verify:assets && npm run verify:story-sources && npm run verify:late-story",
    "verify:story:ci": "npm run verify:assets",
    "verify:assets": "node scripts/check-assets.mjs --quiet",
    "verify:late-story": "npm run verify:late-story-items && npm run verify:late-story-mrc && npm run verify:late-story-hmaps && npm run verify:late-story-set-arc && npm run verify:late-story-source-files",
    "verify:late-story-items": "node scripts/generate-late-story-item-defs.mjs --check",
    "verify:late-story-mrc": "node scripts/generate-late-story-mrc-facts.mjs --check",
    "verify:late-story-hmaps": "node scripts/generate-story-hmaps.mjs --check",
    "verify:late-story-set-arc": "node scripts/verify-late-story-set-arc-facts.mjs",
    "verify:late-story-source-files": "node --import tsx scripts/verify-story-source-files.ts --start 23 --end 31",
    "verify:story-sources": "node --import tsx scripts/verify-story-source-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck:client && npm run typecheck:server && npm run typecheck:test",
    "typecheck:client": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/raid/*.test.ts tests/field/*.test.ts tests/net/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-include=\"src/**/*.tsx\" --test-coverage-include=\"server/**/*.ts\" --test-coverage-lines=82 --test-coverage-branches=80 --test-coverage-functions=68 tests/raid/*.test.ts tests/field/*.test.ts tests/net/*.test.ts",
    "test:e2e": "playwright test",
    "test:raid": "node --import tsx --test tests/raid/*.test.ts",
    "test:field": "node --import tsx --test tests/field/*.test.ts",
    "raid-lab": "node --import tsx scripts/raid-lab/index.ts",
    "raid-lab:smoke": "node --import tsx scripts/raid-lab/index.ts --seeds 100 --policy balanced --max-actions 1500",
    "raid-lab:cohort1k": "node --import tsx scripts/raid-lab/index.ts --seeds 1000 --policy balanced --max-actions 1500"
  },
  "keywords": [
    "srpg",
    "grid",
    "rpg",
    "darksaber"
  ],
  "author": "teemoZipsa",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.21.0"
  }
}
