{
  "name": "sin-eater",
  "version": "0.1.0",
  "description": "Sin Eater — Grid-based SRPG with growth weapon system",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:town": "node scripts/dev-town.mjs",
    "dev:raid": "node scripts/dev-town.mjs raid",
    "dev:raid:aggro": "node scripts/dev-town.mjs raid aggro",
    "dev:raid:loot": "node scripts/dev-town.mjs raid loot",
    "dev:raid:story23": "node scripts/dev-town.mjs raid story23",
    "dev:raid:story31": "node scripts/dev-town.mjs raid story31",
    "dev:tutorial": "npm run dev -- --open /?devStart=tutorial",
    "start": "npm run dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:check": "npx tsx server/check-db.ts",
    "server": "npx tsx server/index.ts",
    "render:status": "node scripts/render-deploy.mjs status",
    "render:deploy": "node scripts/render-deploy.mjs deploy",
    "render:wait": "node scripts/render-deploy.mjs wait",
    "deploy:prod": "node scripts/deploy-production.mjs",
    "verify:late-story": "npm run verify:late-story-items && npm run verify:late-story-mrc",
    "verify:late-story-items": "node scripts/generate-late-story-item-defs.mjs --check",
    "verify:late-story-mrc": "node scripts/generate-late-story-mrc-facts.mjs --check",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/raid/*.test.ts tests/field/*.test.ts tests/net/*.test.ts",
    "test:raid": "node --import tsx --test tests/raid/*.test.ts",
    "test:field": "node --import tsx --test tests/field/*.test.ts"
  },
  "keywords": [
    "srpg",
    "grid",
    "rpg",
    "sin-eater"
  ],
  "author": "teemoZipsa",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.21.0"
  }
}
